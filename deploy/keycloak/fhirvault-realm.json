{
  "realm": "fhirvault",
  "displayName": "fhirvault",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "defaultDefaultClientScopes": [
    "basic"
  ],
  "defaultOptionalClientScopes": [],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"fhir_patient_id\",\"displayName\":\"FHIR Patient id\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject claim in access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fhirvault-audience",
      "description": "Marks tokens as issued for the fhirvault API",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "fhirvault-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "fhirvault-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "launch/patient",
      "description": "SMART standalone launch: puts the user's FHIR Patient id in the 'patient' claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "patient context",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "fhir_patient_id",
            "claim.name": "patient",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "patient/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "patient/*.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "patient/Patient.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "patient/Observation.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "patient/AuditEvent.rs",
      "description": "Lets a patient see who accessed their record",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "user/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "user/*.cruds",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "user/AuditEvent.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "system/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/*.cruds",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/AuditEvent.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "smart-demo-app",
      "name": "SMART demo app (public, authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "fhirvault-audience"
      ],
      "optionalClientScopes": [
        "launch/patient",
        "patient/*.rs",
        "patient/*.read",
        "patient/Patient.rs",
        "patient/Observation.rs",
        "patient/AuditEvent.rs",
        "user/*.rs",
        "user/*.cruds",
        "user/AuditEvent.rs"
      ]
    },
    {
      "clientId": "fhirvault-tester",
      "name": "Developer and test client (password grant; dev only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "fhirvault-audience"
      ],
      "optionalClientScopes": [
        "launch/patient",
        "patient/*.rs",
        "patient/*.read",
        "patient/Patient.rs",
        "patient/Observation.rs",
        "patient/AuditEvent.rs",
        "user/*.rs",
        "user/*.cruds",
        "user/AuditEvent.rs"
      ],
      "description": "DEV/TEST ONLY: password grant for automated tests and Postman. Remove or disable outside local development."
    },
    {
      "clientId": "fhirvault-loader",
      "name": "Backend services client (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "${FHIRVAULT_LOADER_CLIENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "fhirvault-audience",
        "system/*.cruds"
      ],
      "optionalClientScopes": [
        "system/*.rs",
        "system/AuditEvent.rs"
      ]
    }
  ],
  "users": [
    {
      "username": "patient-demo",
      "enabled": true,
      "email": "patient-demo@example.org",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Patient",
      "attributes": {
        "fhir_patient_id": [
          "example-patient"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${FHIRVAULT_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": []
    },
    {
      "username": "clinician-demo",
      "enabled": true,
      "email": "clinician-demo@example.org",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Clinician",
      "credentials": [
        {
          "type": "password",
          "value": "${FHIRVAULT_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "clinician",
        "auditor"
      ]
    },
    {
      "username": "service-account-fhirvault-loader",
      "enabled": true,
      "serviceAccountClientId": "fhirvault-loader"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "clinician",
        "description": "May request user/* clinical scopes"
      },
      {
        "name": "auditor",
        "description": "May request user/AuditEvent.rs"
      }
    ]
  },
  "scopeMappings": [
    {
      "clientScope": "user/*.rs",
      "roles": [
        "clinician"
      ]
    },
    {
      "clientScope": "user/*.cruds",
      "roles": [
        "clinician"
      ]
    },
    {
      "clientScope": "user/AuditEvent.rs",
      "roles": [
        "auditor"
      ]
    }
  ]
}
